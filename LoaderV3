local function redirectURL(url)
    local s = tostring(url)

    -- Khusus file video (.webm) tetap lewat GitHub Raw karena > 20MB
    if string.find(s, "%.webm") then
        s = string.gsub(
            s,
            "https://raw.githubusercontent.com/did%-i%-leave%-the%-oven%-on/Boxten%-Sex%-GUI/refs/heads/main/",
            "https://raw.githubusercontent.com/ricardsteven178/Loader/main/bsgui/"
        )
        return s
    end

    for _, r in ipairs(REDIRECTS) do
        if string.find(s, r.from) then
            s = string.gsub(s, r.from, r.to)
            break
        end
    end

    return s
end

